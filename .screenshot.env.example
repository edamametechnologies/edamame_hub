# Copy to .screenshot.env (gitignored) for local screenshot capture.
#
# The screenshot script auto-detects the domain UUID from the post-login
# redirect, so this is normally NOT needed. Set it only to override the
# auto-detection — required for the demo workspace "acme.com", which the
# dashboard landing page hides (so it can't be auto-detected).
#
# Domain UUID from the Hub URL: https://hub.edamame.tech/dashboard/<THIS_UUID>/home
HUB_SCREENSHOT_DOMAIN_ID=
